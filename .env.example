# DID DOCX Generator - Configuration Template
# Copy this file to .env and customize values for your environment

# ============================================================================
# OUTPUT DIRECTORIES
# ============================================================================

# Directory where generated DOCX files will be saved
OUTPUT_DIR=./output

# Directory for temporary files and cache
TEMP_DIR=./temp

# Directory for images used in documents
IMAGES_DIR=./images


# ============================================================================
# DOCUMENT DEFAULTS
# ============================================================================

# Default document author name
DEFAULT_AUTHOR=Design Team

# Default document version
DEFAULT_VERSION=1.0.0

# Default company/organization name for cover pages
DEFAULT_COMPANY=Your Organization

# Document creation timezone (e.g., UTC, US/Eastern, Europe/London)
DOCUMENT_TIMEZONE=UTC


# ============================================================================
# FONTS
# ============================================================================

# Primary font family for body text
FONT_FAMILY=Calibri

# Default body text font size (in points)
FONT_SIZE_BODY=11

# Heading 1 font size
FONT_SIZE_HEADING_1=24

# Heading 2 font size
FONT_SIZE_HEADING_2=16

# Heading 3 font size
FONT_SIZE_HEADING_3=13

# Default line spacing (1.0 = single, 1.15 = default, 1.5 = one-and-half, 2.0 = double)
LINE_SPACING=1.15


# ============================================================================
# COLORS
# ============================================================================

# Primary color (RGB, comma-separated: R,G,B)
# Default: Professional blue
PRIMARY_COLOR=41,128,185

# Accent color (RGB)
# Default: Dark blue-gray
ACCENT_COLOR=52,73,94

# Text color (RGB)
# Default: Dark gray
TEXT_COLOR=51,51,51

# Light gray for backgrounds
LIGHT_GRAY=242,242,242

# Success color (RGB)
SUCCESS_COLOR=46,204,113

# Warning color (RGB)
WARNING_COLOR=230,126,34

# Error color (RGB)
ERROR_COLOR=231,76,60


# ============================================================================
# MARGINS AND SPACING
# ============================================================================

# Top margin in inches
MARGIN_TOP=1.0

# Bottom margin in inches
MARGIN_BOTTOM=1.0

# Left margin in inches
MARGIN_LEFT=1.0

# Right margin in inches
MARGIN_RIGHT=1.0

# Spacing before paragraphs (in points)
PARAGRAPH_SPACE_BEFORE=0

# Spacing after paragraphs (in points)
PARAGRAPH_SPACE_AFTER=6


# ============================================================================
# DESIGN DISCIPLINE
# ============================================================================

# Design discipline for formatter selection
# Options: architecture, interior, graphic, 3d, uiux
DESIGN_DISCIPLINE=architecture


# ============================================================================
# LOGGING
# ============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable detailed logging output
DEBUG_MODE=false


# ============================================================================
# IMAGE SETTINGS
# ============================================================================

# Default image width in inches (when not specified)
DEFAULT_IMAGE_WIDTH=5.5

# Compress images when embedding (reduces file size)
COMPRESS_IMAGES=true

# Maximum image quality when compressing (0-100)
IMAGE_QUALITY=85


# ============================================================================
# TABLE SETTINGS
# ============================================================================

# Default table style name
TABLE_STYLE=Light Grid Accent 1

# Enable alternating row colors in tables
TABLE_ALTERNATING_COLORS=true

# Header row background color (use PRIMARY_COLOR by default)
TABLE_HEADER_COLOR=


# ============================================================================
# DOCUMENT FEATURES
# ============================================================================

# Include table of contents (page will be auto-generated)
INCLUDE_TOC=true

# Include footers with page numbers
INCLUDE_FOOTERS=true

# Include cover page
INCLUDE_COVER=true

# Generate document outline/bookmarks (useful for navigation in PDF)
GENERATE_OUTLINE=true


# ============================================================================
# PROFESSIONAL SETTINGS
# ============================================================================

# Document footer text (shown with page numbers)
FOOTER_TEXT=Design Standards

# Include modification tracking/version history
TRACK_CHANGES=false

# Document security level: none, basic, restricted
SECURITY_LEVEL=none

# Require password to open document (if security_level is not 'none')
# DOCUMENT_PASSWORD=

# Mark document as final/read-only
MARK_AS_FINAL=false

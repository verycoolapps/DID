# DID Skill - Git Attributes
# Proper handling of line endings and binary files

# Auto detect text files and normalize line endings
* text=auto

# Markdown files
*.md text eol=lf
*.markdown text eol=lf

# Python files
*.py text eol=lf
*.pyw text eol=lf
*.pyx text eol=lf
*.pyi text eol=lf
*.pxd text eol=lf
*.pxs text eol=lf
*.pxt text eol=lf
*.pxing text eol=lf

# Shell scripts
*.bash text eol=lf
*.sh text eol=lf
*.zsh text eol=lf

# Windows shells
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Documentation
*.txt text eol=lf
LICENSE text eol=lf
CHANGELOG.md text eol=lf

# JSON
*.json text eol=lf
*.jsonc text eol=lf
*.geojson text eol=lf

# YAML
*.yaml text eol=lf
*.yml text eol=lf

# TOML
*.toml text eol=lf

# INI
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf

# Diffs
*.diff text eol=lf
*.patch text eol=lf

# Binary files
*.bin binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.zip binary
*.tar binary
*.gz binary
*.docx binary
*.xlsx binary
*.pptx binary
*.pdf binary

# Media
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.wav binary

# Keep LF endings in repo
.gitattributes text eol=lf
.gitignore text eol=lf
